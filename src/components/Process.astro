---
import { Picture } from 'astro:assets';
import dough from '../assets/photos/kula-ciasta.jpg';
import stretch from '../assets/photos/rozciaganie.jpg';
import peel from '../assets/photos/piec-lopata.jpg';

const steps = [
  {
    at: '0 h',
    title: 'Zarób',
    text: 'Mąka typu 00, zimna woda, sól morska i 1 g drożdży na kilogram mąki. Ciasto od razu trafia do chłodni, gdzie ma 4 °C.',
    img: null,
  },
  {
    at: '24 h',
    title: 'Kule po 260 g',
    text: 'Dzielimy ciasto ręcznie na kule i zostawiamy w drewnianych skrzynkach. Gluten dojrzewa powoli, więc pizza jest lekka i nie ciąży.',
    img: { src: dough, alt: 'Kula ciasta trzymana w dłoniach' },
  },
  {
    at: '48 h',
    title: 'Rozciąganie dłońmi',
    text: 'Każdą kulę rozciągamy palcami, bez wałka. Powietrze zostaje w brzegu i w piecu rośnie z niego puszysty cornicione.',
    img: { src: stretch, alt: 'Dłonie rozciągające ciasto na blacie posypanym mąką' },
  },
  {
    at: '90 s',
    title: 'Piec, 485 °C',
    text: 'Palimy bukiem i dębem w piecu z cegły szamotowej. Półtorej minuty wystarczy: brzeg dostaje ciemne plamki, a środek zostaje miękki.',
    img: { src: peel, alt: 'Pizza na łopacie w piecu, za nią płonie drewno' },
  },
];
---

<section class="proc soot section" id="ciasto" aria-labelledby="proc-title">
  <div class="wrap proc__grid">
    <div class="proc__head">
      <h2 id="proc-title">48 godzin ciasta, 90&nbsp;sekund ognia</h2>
      <p class="lead">Krótka karta pozwala nam robić jedno ciasto i robić je dobrze. Tak wygląda droga każdej pizzy, zanim trafi na stół.</p>
    </div>
    <div class="axis">
      <span class="axis__line" aria-hidden="true"><span class="axis__fill"></span></span>
      <ol class="axis__list">
      {
        steps.map((s) => (
          <li class="step">
            <p class="step__at">{s.at}</p>
            <div class="step__body">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
            {s.img && (
              <div class="step__img">
              <Picture
                src={s.img.src}
                alt={s.img.alt}
                widths={[320, 520, 760]}
                sizes="(min-width: 60rem) 18rem, 80vw"
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                quality={70}
                loading="lazy"
                decoding="async"
              />
              </div>
            )}
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>

<style>
  .proc__grid {
    display: grid;
    gap: var(--c2) var(--c4);
  }

  .proc__head {
    display: grid;
    gap: var(--c1);
    align-content: start;
  }

  .proc__head .lead {
    color: var(--on-dark-soft);
  }

  .axis {
    position: relative;
    padding-left: clamp(1.75rem, 5vw, 3rem);
  }

  .axis__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--c3);
  }

  .axis__line {
    position: absolute;
    left: 0.3125rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 6px;
    background: var(--soot-2);
  }

  .axis__fill {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(-58deg, var(--paint) 0 3px, #b9ad99 3px 5px, var(--paint) 5px 7px);
    transform-origin: top;
  }

  .step {
    position: relative;
    display: grid;
    gap: 0.75rem 2rem;
    grid-template-columns: minmax(0, 1fr);
  }

  .step::before {
    content: '';
    position: absolute;
    left: calc(-1 * clamp(1.75rem, 5vw, 3rem) - 0.25rem + 0.375rem);
    top: 0.75rem;
    width: 1.25rem;
    height: 1.25rem;
    background: var(--soot);
    border: 4px solid var(--paint);
    border-radius: 50%;
    translate: -0.0625rem 0;
  }

  .step__at {
    font-family: var(--sign);
    font-size: clamp(3.25rem, 6vw, 4.75rem);
    font-weight: 900;
    line-height: 0.85;
    white-space: nowrap;
    color: var(--paint);
    font-variant-numeric: lining-nums;
  }

  .step__body {
    display: grid;
    gap: 0.5rem;
    max-width: 36rem;
  }

  .step__body p {
    color: var(--on-dark-soft);
  }

  .step__img {
    width: 100%;
    max-width: 20rem;
  }

  .step__img :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 0.5rem solid var(--iron);
  }

  @media (min-width: 60rem) {
    .proc__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .proc__head {
      position: sticky;
      top: 7rem;
    }

    .step {
      grid-template-columns: 10.5rem minmax(0, 1fr);
    }

    .step__img {
      grid-column: 2;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .axis__fill {
        animation: fill linear both;
        animation-timeline: view();
        animation-range: entry 30% cover 75%;
      }

      .step::before {
        animation: lit linear both;
        animation-timeline: view();
        animation-range: entry 60% cover 45%;
      }
    }
  }

  @keyframes fill {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes lit {
    from {
      background: var(--soot);
    }
    to {
      background: var(--brick);
      border-color: var(--brick);
    }
  }
</style>
