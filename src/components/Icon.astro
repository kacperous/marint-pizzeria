---
import phone from 'lucide-static/icons/phone.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';
import clock from 'lucide-static/icons/clock.svg?raw';
import leaf from 'lucide-static/icons/leaf.svg?raw';
import sprout from 'lucide-static/icons/sprout.svg?raw';
import flame from 'lucide-static/icons/flame.svg?raw';
import star from 'lucide-static/icons/star.svg?raw';
import menu from 'lucide-static/icons/menu.svg?raw';
import x from 'lucide-static/icons/x.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import bike from 'lucide-static/icons/bike.svg?raw';
import calendar from 'lucide-static/icons/calendar.svg?raw';
import check from 'lucide-static/icons/check.svg?raw';
import mail from 'lucide-static/icons/mail.svg?raw';

const instagram = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg>`;
const facebook = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V21"/><path d="M6 11h9"/></svg>`;

const icons = { phone, mapPin, clock, leaf, sprout, flame, star, menu, x, arrowUpRight, bike, calendar, check, mail, instagram, facebook };

interface Props {
  name: keyof typeof icons;
  class?: string;
  label?: string;
}

const { name, class: className = 'icon', label } = Astro.props;
const svg = icons[name]
  .replace(/<!--.*?-->/s, '')
  .replace(/class="[^"]*"/, '')
  .replace('<svg', `<svg class="${className}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'}`);
---

<Fragment set:html={svg} />
