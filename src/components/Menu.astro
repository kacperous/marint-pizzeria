---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { rosse, bianche, extras, type Pizza } from '../data/site';
import margherita from '../assets/photos/margherita.jpg';
import bufalina from '../assets/photos/marinara-bazylia.jpg';
import stracciatella from '../assets/photos/bufala.jpg';
import funghi from '../assets/photos/funghi.jpg';

const shots = [
  { src: margherita, name: 'Margherita', alt: 'Margherita z bazylią, widok z boku' },
  { src: bufalina, name: 'Bufalina', alt: 'Bufalina z mozzarellą di bufala i bazylią, zbliżenie' },
  { src: stracciatella, name: 'Stracciatella', alt: 'Pizza ze stracciatellą i bazylią na talerzu, widok z góry' },
  { src: funghi, name: 'Funghi e spinaci', alt: 'Pizza z grzybami i szpinakiem pokrojona na kawałki' },
];

const groups: { id: string; title: string; note: string; items: Pizza[] }[] = [
  { id: 'rosse', title: 'Rosse', note: 'z sosem z pomidorów San Marzano', items: rosse },
  { id: 'bianche', title: 'Bianche', note: 'bez sosu pomidorowego', items: bianche },
];
---

<section class="menu lime section" id="karta" aria-labelledby="menu-title">
  <div class="wrap">
    <div class="menu__head">
      <h2 id="menu-title">Karta</h2>
      <p class="lead">Dziesięć pizz, każda ok. 30 cm, pieczona na zamówienie. Ceny w złotych, z VAT.</p>
      <ul class="legend" aria-label="Oznaczenia">
        <li><Icon name="leaf" />wegetariańska</li>
        <li><Icon name="sprout" />wegańska</li>
        <li><Icon name="flame" />ostra</li>
      </ul>
    </div>

    <ul class="shots" aria-label="Zdjęcia wybranych pizz">
      {
        shots.map((s) => (
          <li class="shot">
            <Picture
              src={s.src}
              alt={s.alt}
              widths={[280, 420, 600]}
              sizes="(min-width: 60rem) 18rem, 70vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              quality={70}
              loading="lazy"
              decoding="async"
            />
            <span class="shot__name">{s.name}</span>
          </li>
        ))
      }
    </ul>

    <div class="menu__cols">
      {
        groups.map((g) => (
          <section class="group" aria-labelledby={`g-${g.id}`}>
            <h3 class="group__title" id={`g-${g.id}`}>
              {g.title} <span>{g.note}</span>
            </h3>
            <ul class="items">
              {g.items.map((p) => (
                <li class="item">
                  <div class="item__top">
                    <h4 class="item__name">
                      {p.name}
                      {p.veg && <Icon name="leaf" label="wegetariańska" />}
                      {p.vegan && <Icon name="sprout" label="wegańska" />}
                      {p.hot && <Icon name="flame" label="ostra" />}
                    </h4>
                    <span class="item__dots" aria-hidden="true" />
                    <span class="tag price">{p.price} zł</span>
                  </div>
                  <p class="item__ing">{p.ingredients}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <section class="group group--extras" aria-labelledby="g-extras">
        <h3 class="group__title" id="g-extras">Na deser i do picia</h3>
        <ul class="items items--tight">
          {
            extras.map((e) => (
              <li class="item">
                <div class="item__top">
                  <span class="item__plain">{e.name}</span>
                  <span class="item__dots" aria-hidden="true" />
                  <span class="price">{e.price} zł</span>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <p class="note menu__note">Alergeny podajemy przy stoliku i przez telefon. Ciasto bez glutenu niestety nie wyjdzie w naszym piecu.</p>
  </div>
</section>

<style>
  .menu__head {
    display: grid;
    gap: var(--c1);
    margin-bottom: var(--c2);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    color: var(--ink-soft);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .legend :global(svg),
  .item__name :global(svg) {
    color: var(--iron);
  }

  .shots {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(14rem, 1fr);
    gap: var(--c1);
    margin: 0 0 var(--c3);
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--brick) transparent;
  }

  .shot {
    position: relative;
    scroll-snap-align: start;
  }

  .shot :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 0.5rem solid var(--iron);
  }

  .shot__name {
    position: absolute;
    left: 0.5rem;
    bottom: 0.5rem;
    padding: 0.375rem 0.75rem;
    background: var(--soot);
    color: var(--paint);
    font-family: var(--sign);
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .menu__cols {
    display: grid;
    gap: var(--c3) var(--c4);
  }

  .group__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.5rem;
    border-bottom: 3px solid var(--ink);
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  .group__title span {
    font-family: var(--text);
    font-size: 1rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-soft);
  }

  .items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    padding-block: 1rem;
    border-bottom: 1px solid var(--lime-2);
  }

  .items--tight .item {
    padding-block: 0.625rem;
  }

  .item__top {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .item__name {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .item__name :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .item__plain {
    font-weight: 600;
  }

  .item__dots {
    flex: 1;
    min-width: 1rem;
    border-bottom: 2px dotted #a39c90;
    translate: 0 -0.3rem;
  }

  .tag {
    padding: 0.25rem 0.625rem;
    background: var(--brick);
    color: var(--paint);
    font-size: 1.25rem;
    outline: 1px dashed rgb(235 231 220 / 0.7);
    outline-offset: -4px;
  }

  .item__ing {
    margin-top: 0.25rem;
    max-width: 40ch;
    color: var(--ink-soft);
  }

  .menu__note {
    margin-top: var(--c2);
    max-width: 60ch;
  }

  @media (min-width: 60rem) {
    .menu__head {
      grid-template-columns: auto 1fr;
      align-items: end;
      column-gap: var(--c3);
    }

    .menu__head .legend {
      grid-column: 2;
    }

    .menu__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .group:first-child {
      grid-row: span 2;
    }
  }

  @media (max-width: 30rem) {
    .shots {
      grid-auto-columns: 72%;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
    }
  }
</style>
