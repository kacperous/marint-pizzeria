---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths: number[];
  eager?: boolean;
  arched?: boolean;
  class?: string;
  position?: string;
}

const { src, alt, sizes, widths, eager = false, arched = true, class: className = '', position = 'center' } = Astro.props;
---

<figure class:list={['win', { 'win--arch': arched }, className]}>
  <div class="win__frame">
    <Picture
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={72}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      style={`object-position:${position}`}
    />
    <span class="win__bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
  </div>
  <slot />
</figure>

<style>
  .win {
    position: relative;
    margin: 0;
  }

  .win__frame {
    position: relative;
    height: 100%;
    overflow: hidden;
    border: 0.625rem solid var(--iron);
    background: var(--soot);
    box-shadow:
      0 0 0 3px var(--brick-joint),
      0 0.75rem 1.5rem -0.75rem rgb(26 21 18 / 0.55);
  }

  .win--arch .win__frame {
    border-radius: 50% 50% 0 0 / 3.25rem 3.25rem 0 0;
  }

  .win__frame :global(picture),
  .win__frame :global(img) {
    width: 100%;
    height: 100%;
  }

  .win__frame :global(img) {
    object-fit: cover;
  }

  .win__bars {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    pointer-events: none;
  }

  .win__bars i {
    box-shadow: inset 0 0 0 3px var(--iron);
  }
</style>
